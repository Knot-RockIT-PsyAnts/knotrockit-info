---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// Props interface for the component
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: any;
}

// Destructuring Astro.props to get the component's props
let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  fit,
} = Astro.props;

const isSvg = format === "svg" || src.toLowerCase().endsWith(".svg");

// SVGs are located in /public/images/... and should be delivered directly.
// We expect “src” to already be a public URL, e.g., “/images/knot_logo.svg.”
const publicSrc = src;

// For raster images, we continue to use astro:assets (import via glob).
const srcInPublicForGlob = `/public${src}`;

// Glob pattern to load images from the /public/images folder
const images = import.meta.glob(
  "/public/images/**/*.{jpeg,jpg,png,gif,webp,avif}",
);

// Check if the source path is valid (only relevant for raster images)
const isValidPath = isSvg ? true : !!images[srcInPublicForGlob];

// Log a warning message in red if the image is not found
!isValidPath &&
  console.error(
    `\x1b[31mImage not found - ${srcInPublicForGlob}.\x1b[0m Make sure the image is in the /public/images folder.`,
  );
---

{
  isSvg ? (
    <img
      src={publicSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading ?? undefined}
      decoding={decoding ?? undefined}
      class={className}
      style={style}
    />
  ) : (
    isValidPath && (
      <Image
        src={images[srcInPublicForGlob]() as Promise<{ default: ImageMetadata }>}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fit={fit ? fit : "contain"}
        decoding={decoding}
        class={className}
        format={format}
        style={style}
      />
    )
  )
}
