{
  "site": {
    "title": "Knot RockIT PsyAnts",
    "base_url": "https://knotrockit.org",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/Knot_RockIT_PsyAnts_Icon.svg",
    "logo": "/images/Knot_RockIT_PsyAnts_Logo_Black.png",
    "logo_darkmode": "/images/Knot_RockIT_PsyAnts_Logo_White.png",
    "logo_width": "410",
    "logo_height": "37",
    "logo_text": "Knot RockIT PsyAnts Logo"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog",
    "default_language": "de",
    "disable_languages": ["fr"],
    "default_language_in_subdir": false
  },

  "announcement": {
    "enable": false,
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "© 2026 Knot RockIT PsyAnts"
  },

  "navigation_button": {
    "enable": false,
    "label": "Github",
    "link": "https://github.com/zeon-studio/astroplate/tree/multilingual"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "Knot RockIT PsyAnts",
    "meta_image": "/images/Knot_RockIT_PsyAnts_Sustainable_Design.png",
    "meta_description": "Digital innovation for a fairer, sustainable society. We are Knot RockIT PsyAnts. We develop ethically grounded, human-centered digital solutions for the major challenges of our time."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
